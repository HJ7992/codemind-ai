# CodeMind AI 本地环境示例。复制为未跟踪的 deploy/.env 后填写，禁止提交真实值。
# 当前仅为冻结配置契约，不代表服务已经实现。

COMPOSE_PROJECT_NAME=codemind-ai
CODEMIND_BIND_HOST=127.0.0.1

# MySQL：以下均为本地占位符，启动前应替换。
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=codemind
MYSQL_USER=codemind
MYSQL_PASSWORD=replace_with_local_database_password
CODEMIND_DATABASE_URL=jdbc:mysql://mysql:3306/codemind?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# 内部服务与存储：不得向浏览器暴露内部服务凭证。
CODEMIND_AI_BASE_URL=http://ai-service:8000
CODEMIND_INTERNAL_SERVICE_TOKEN=replace_with_random_internal_service_token
CODEMIND_SOURCE_ROOT=/data/sources
CODEMIND_QDRANT_URL=http://qdrant:6333
CODEMIND_QDRANT_COLLECTION=codemind_chunks

# 外部 Chat：地址会在上传前以脱敏形式展示，密钥永不进入前端。
CODEMIND_CHAT_BASE_URL=https://your-chat-provider.example/v1
CODEMIND_CHAT_MODEL=replace_with_chat_model
CODEMIND_CHAT_API_KEY=replace_with_chat_api_key
CODEMIND_CHAT_TIMEOUT_SECONDS=45

# 外部 Embedding：索引代码块也会外发；维度必须与模型实际输出一致。
CODEMIND_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
CODEMIND_EMBEDDING_MODEL=replace_with_embedding_model
CODEMIND_EMBEDDING_API_KEY=replace_with_embedding_api_key
CODEMIND_EMBEDDING_TIMEOUT_SECONDS=30
CODEMIND_EMBEDDING_BATCH_SIZE=16
CODEMIND_EMBEDDING_DIMENSIONS=1536

# 隐私告知：地址、数据用途或提示变化时更新版本，使用户重新确认。
CODEMIND_PRIVACY_NOTICE_VERSION=2026-10-29.v1

# 上传限制。
CODEMIND_UPLOAD_MAX_ZIP_BYTES=52428800
CODEMIND_UPLOAD_MAX_UNCOMPRESSED_BYTES=209715200
CODEMIND_UPLOAD_MAX_ENTRIES=10000
CODEMIND_UPLOAD_MAX_SOURCE_FILE_BYTES=2097152
CODEMIND_UPLOAD_MAX_PATH_DEPTH=20
CODEMIND_UPLOAD_MAX_COMPRESSION_RATIO=100

# 调用与恢复：模型请求不自动重试；索引最大尝试次数包含崩溃恢复。
CODEMIND_INDEX_MAX_ATTEMPTS=2
CODEMIND_AI_INDEX_TIMEOUT_SECONDS=1800
CODEMIND_AI_QA_TIMEOUT_SECONDS=60
CODEMIND_PUBLIC_QA_TIMEOUT_SECONDS=65
CODEMIND_AI_RETRIEVAL_TIMEOUT_SECONDS=15
CODEMIND_AI_DELETE_TIMEOUT_SECONDS=30
CODEMIND_QUERY_DEFAULT_TOP_K=5
CODEMIND_QUERY_MAX_TOP_K=20
